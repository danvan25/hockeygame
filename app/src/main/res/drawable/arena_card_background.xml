<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/surface_dark" />

            <stroke
                android:width="2dp"
                android:color="@color/arena_selected_stroke" />

            <corners android:radius="16dp" />

            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/surface_dark" />

            <stroke
                android:width="1dp"
                android:color="@color/input_stroke" />

            <corners android:radius="16dp" />

            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />

        </shape>
    </item>

</selector>